{
  "name": "swifood-cashier-offline",
  "version": "1.0.36",
  "description": "Standalone offline cashier with local SQLite storage",
  "main": "./out/main/index.js",
  "author": "Paycools",
  "homepage": "https://www.swifood.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:main-debug": "electron-vite dev --inspect=9229",
    "dev:main-break": "electron-vite dev --inspectBrk=9229",
    "agent:check": "tsc --noEmit -p tsconfig.agent.json",
    "swifood-patch": "node scripts/swifood-version.mjs patch",
    "swifood-build:win:test": "node scripts/swifood-version.mjs build-win-test",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win:test": "npm run swifood-build:win:test",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@akashrajpurohit/snowflake-id": "^2.0.0",
    "@ant-design/icons": "^6.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/core": "^1.3.0",
    "@langchain/deepseek": "^1.1.19",
    "@langchain/langgraph": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "antd": "^6.3.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "big.js": "^7.0.1",
    "dayjs": "^1.11.20",
    "dotenv": "^18.0.9",
    "gsap": "^3.15.0",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.17.23",
    "langchain": "^1.5.19",
    "motion": "^12.38.0",
    "prop-types": "^15.8.1",
    "react-i18next": "^16.5.4",
    "react-router": "^6.30.3",
    "zustand": "^5.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
